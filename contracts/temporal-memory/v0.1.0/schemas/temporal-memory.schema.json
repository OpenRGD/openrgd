{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:openrgd:temporal-memory:v0.1-candidate",
  "title": "CORE-D Temporal / Memory / Oneiric candidate — NOT authority",
  "oneOf": [
    {
      "$ref": "#/$defs/HistoricalTimeAssertion"
    },
    {
      "$ref": "#/$defs/ImportAnchorEvidence"
    },
    {
      "$ref": "#/$defs/EvidenceAvailability"
    },
    {
      "$ref": "#/$defs/CognitiveCommitment"
    },
    {
      "$ref": "#/$defs/SalienceHint"
    },
    {
      "$ref": "#/$defs/MemoryAnnotation"
    },
    {
      "$ref": "#/$defs/OneiricReview"
    },
    {
      "$ref": "#/$defs/ContinuityCheckpoint"
    },
    {
      "$ref": "#/$defs/HistoryCommitRequest"
    },
    {
      "$ref": "#/$defs/HistoryCommitReceipt"
    }
  ],
  "$defs": {
    "Ref": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:/#@+-]{0,255}$"
    },
    "Digest": {
      "type": "string",
      "pattern": "^sha256:[a-f0-9]{64}$"
    },
    "Reason": {
      "type": "string",
      "pattern": "^[A-Z][A-Z0-9_]{0,63}$"
    },
    "HistoricalTimeAssertion": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema_version",
        "record_type",
        "record_id",
        "producer_ref",
        "evidence_refs",
        "grants_authority",
        "source_event_ref",
        "claimed_time_token",
        "source_clock_domain_ref",
        "timestamp_format",
        "time_quality",
        "uncertainty_ms",
        "assertion_kind",
        "measured_by_chronograf"
      ],
      "properties": {
        "schema_version": {
          "const": "openrgd_temporal_memory_v0.1-candidate"
        },
        "record_id": {
          "$ref": "#/$defs/Ref"
        },
        "producer_ref": {
          "$ref": "#/$defs/Ref"
        },
        "evidence_refs": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/Ref"
          },
          "minItems": 0,
          "maxItems": 64,
          "uniqueItems": true
        },
        "grants_authority": {
          "const": false
        },
        "record_type": {
          "const": "HistoricalTimeAssertion"
        },
        "source_event_ref": {
          "$ref": "#/$defs/Ref"
        },
        "claimed_time_token": {
          "type": "string",
          "minLength": 1,
          "maxLength": 80,
          "pattern": "^[A-Za-z0-9:TZ.+-]+$"
        },
        "source_clock_domain_ref": {
          "$ref": "#/$defs/Ref"
        },
        "timestamp_format": {
          "enum": [
            "LEGACY_POSIX_SECONDS",
            "ISO8601_SOURCE",
            "MONOTONIC_TICKS",
            "LOGICAL_COUNTER"
          ]
        },
        "time_quality": {
          "enum": [
            "UNATTESTED",
            "SOURCE_REPORTED",
            "UNKNOWN"
          ]
        },
        "uncertainty_ms": {
          "anyOf": [
            {
              "type": "integer",
              "minimum": 0,
              "maximum": 9007199254740991
            },
            {
              "type": "null"
            }
          ]
        },
        "assertion_kind": {
          "const": "HISTORICAL_EVENT_TIME_CLAIM"
        },
        "measured_by_chronograf": {
          "const": false
        }
      }
    },
    "ImportAnchorEvidence": {
      "type": "object",
      "additionalProperties": false,
