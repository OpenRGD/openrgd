          "const": false
        },
        "record_type": {
          "const": "EvidenceAvailability"
        },
        "evidence_ref": {
          "$ref": "#/$defs/Ref"
        },
        "content_sha256": {
          "$ref": "#/$defs/Digest"
        },
        "reported_state": {
          "enum": [
            "AVAILABLE",
            "WITHHELD",
            "MISSING",
            "REDACTED",
            "ERASED"
          ]
        },
        "reason_code": {
          "$ref": "#/$defs/Reason"
        },
        "retention_policy_ref": {
          "anyOf": [
            {
              "$ref": "#/$defs/Ref"
            },
            {
              "type": "null"
            }
          ]
        },
        "affected_storage_locations": {
          "type": "array",
          "items": {
            "enum": [
              "L1_VAULT",
              "L2_LINK",
              "L3_INDEX",
              "L4_VIEW",
              "CACHE",
              "REPLICA",
              "BACKUP"
            ]
          },
          "minItems": 0,
          "maxItems": 7,
          "uniqueItems": true
        },
        "assessment_clock_domain_ref": {
          "$ref": "#/$defs/Ref"
        },
        "assessed_at_ms": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "proof_ref": {
          "anyOf": [
            {
              "$ref": "#/$defs/Ref"
            },
            {
              "type": "null"
            }
          ]
        },
        "verification_state": {
          "const": "REPORTED_NOT_ATTESTED"
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "reported_state": {
                "enum": [
                  "REDACTED",
                  "ERASED"
                ]
              }
            }
          },
          "then": {
            "properties": {
              "retention_policy_ref": {
                "$ref": "#/$defs/Ref"
              }
            }
          }
        }
      ]
    },
