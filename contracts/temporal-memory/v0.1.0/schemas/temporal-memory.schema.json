        "reported_state",
        "reason_code",
        "retention_policy_ref",
        "affected_storage_locations",
        "assessment_clock_domain_ref",
        "assessed_at_ms",
        "proof_ref",
        "verification_state"
      ],
      "properties": {
        "schema_version": {
          "const": "openrgd_temporal_memory_v0.1-candidate"
        },
        "record_id": {
          "$ref": "#/$defs/Ref"
        },
        "producer_ref": {
          "$ref": "#/$defs/Ref"
        },
        "evidence_refs": {
          "type": "array",
