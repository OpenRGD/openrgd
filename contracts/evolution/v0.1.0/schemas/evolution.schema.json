        "robot_instance_ref",
        "physical_enrollment_ref",
        "actor_claim_ref",
        "evidence_refs",
        "claimed_event_time",
        "history_commit_receipt_ref",
        "grants_authority",
        "physical_execution_authorized",
        "life_identity_issued",
        "history_committed",
        "calibration_verified",
        "before_revision_ref",
        "before_revision_digest",
        "after_revision_ref",
        "after_revision_digest",
        "design_source_root_before",
        "design_source_root_after",
        "visual_manifest_before",
        "visual_manifest_after",
        "change_kind",
        "assertion_stage",
        "slot_changes",
        "affected_links",
        "affected_joints",
        "affected_sensors",
        "invalidated_calibration_refs",
        "requires_calibration_review",
        "requires_safety_review",
