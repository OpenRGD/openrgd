            {
              "type": "string",
              "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:/@#+-]{0,191}$"
            },
            {
              "type": "null"
            }
          ]
        },
        "evidence_refs": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:/@#+-]{0,191}$"
          },
          "maxItems": 64,
          "uniqueItems": true
        },
        "claimed_event_time": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "token",
