          ],
          "properties": {
            "token": {
              "anyOf": [
                {
                  "type": "string",
                  "maxLength": 128
                },
                {
                  "type": "null"
                }
              ]
            },
            "clock_domain": {
              "anyOf": [
                {
                  "type": "string",
                  "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:/@#+-]{0,191}$"
                },
                {
                  "type": "null"
                }
              ]
            }
          }
        },
        "history_commit_receipt_ref": {
          "anyOf": [
            {
              "type": "string",
              "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:/@#+-]{0,191}$"
            },
            {
              "type": "null"
            }
          ]
        },
        "grants_authority": {
          "const": false
        },
        "physical_execution_authorized": {
          "const": false
        },
        "life_identity_issued": {
          "const": false
        },
        "history_committed": {
          "const": false
        },
        "calibration_verified": {
          "const": false
        },
        "before_revision_ref": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:/@#+-]{0,191}$"
        },
        "before_revision_digest": {
          "type": "string",
          "pattern": "^sha256:[a-f0-9]{64}$"
