          "properties": {
            "plasticity_policy_ref": {
              "const": "05_evolution/plasticity.jsonc"
            },
            "hardware_mutation_policy_ref": {
              "const": "05_evolution/hardware_mutation.jsonc"
            },
            "policy_source_root_claim": {
              "anyOf": [
