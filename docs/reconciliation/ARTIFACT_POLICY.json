{
  "policy_version": "2.0.0",
  "status": "DECIDED_FOR_RECONCILIATION",
  "canonical_source_root": "spec",
  "standard_mirror_root": "standard",
  "default_seed_root": "src/openrgd/seeds/default/spec",
  "canonical_file_selection": {
    "jsonc_recursive": true,
    "static_files": [
      "MANIFESTO.md"
    ],
    "excluded_source_files": [
      "01_spec.jsonc",
      "02_spec.jsonc",
      "03_spec.jsonc",
      "04_spec.jsonc",
      "05_spec.jsonc",
      "06_spec.jsonc",
      "openrgd_unified_spec.jsonc",
      "openrgd_unified_spec_document.jsonc"
    ]
  },
  "canonical_hash": {
    "profile": "OPENRGD_SOURCE_TREE_SHA256_V1",
    "algorithm": "SHA-256",
    "source_bytes": "exact tracked UTF-8 bytes after Git LF normalization",
    "path_order": "lexicographic POSIX relative paths",
    "manifest_self_field": "meta_group.integrity_hash_str",
    "manifest_self_value": "sha256:SELF",
    "index_serialization": {
      "encoding": "UTF-8",
      "sort_keys": true,
      "separators": [",", ":"],
      "allow_nan": false,
      "ensure_ascii": false
    }
  },
  "standard_mirror": {
    "jsonc_target_extension": ".json",
    "comparison": "parsed-json-equivalence",
    "static_comparison": "byte-exact",
    "allowed_generated_paths": []
  },
  "default_seed": {
    "comparison": "byte-exact",
    "allowed_extra_paths": [],
    "allowed_overrides": [],
    "override_required_fields": [
      "path",
      "classification",
      "reason",
      "decision_ref",
      "canonical_sha256",
      "seed_sha256"
    ]
  },
  "generated_artifacts": {
    "tracked": false,
    "default_machine_bundle": "spec/openrgd_unified_spec.json",
    "ignored_paths": [
      "spec/0[1-6]_spec.jsonc",
      "spec/openrgd_unified_spec*.json*",
      "standard/0[1-6]_spec.json",
      "standard/openrgd_unified_spec*.json",
      "standard/benchmarks/**",
      "RGD-*/**",
      "my-robots/**",
      "export/**"
    ]
  },
  "non_retroactivity_rule": "This policy controls repository convergence from 2026-09-02 onward. It does not rewrite the maturity or meaning of historical artifacts."
}
