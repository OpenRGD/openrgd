#usda 1.0
# SPDX-License-Identifier: MIT
(
    defaultPrim = "OpenRGDUsdArm"
    kilogramsPerUnit = 1
    metersPerUnit = 0.01
    upAxis = "Z"
)

def Xform "OpenRGDUsdArm"
{
    def Xform "base_link" {}
    def Xform "arm_link" {}
    def Xform "slider_link" {}

    def PhysicsRevoluteJoint "shoulder_joint"
    {
        rel physics:body0 = </OpenRGDUsdArm/base_link>
        rel physics:body1 = </OpenRGDUsdArm/arm_link>
        uniform token physics:axis = "Y"
        float physics:lowerLimit = -90
        float physics:upperLimit = 45
        float drive:angular:physics:maxForce = 45000
        float drive:angular:physics:stiffness = 120
        float drive:angular:physics:damping = 4
    }

    def PhysicsPrismaticJoint "slide_joint"
    {
        rel physics:body0 = </OpenRGDUsdArm/arm_link>
        rel physics:body1 = </OpenRGDUsdArm/slider_link>
        uniform token physics:axis = "X"
        float physics:lowerLimit = 0
        float physics:upperLimit = 20
        float drive:linear:physics:maxForce = 5000
        float drive:linear:physics:stiffness = 250
        float drive:linear:physics:damping = 8
    }
}
